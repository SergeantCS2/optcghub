 "rise":         { "gain": -12, "max": 0.9, "layers": [ { "synth": "rise" }, { "kenney": "interface-sounds/maximize_006.ogg", "gain": -4, "offset": 0.5 } ] },
 "impact":       { "gain": -4,  "max": 1.6, "layers": [ { "kenney": "impact-sounds/impactPunch_heavy_000.ogg" }, { "kenney": "sci-fi-sounds/lowFrequency_explosion_000.ogg", "gain": -5 } ] },
